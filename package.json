{
  "name": "outdoor-affiliate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "x:generate": "node --dns-result-order=ipv4first scripts/generate-x-posts.js",
    "x:generate:auto": "node --dns-result-order=ipv4first scripts/generate-x-posts.js --auto-approve",
    "x:queue": "node scripts/queue-to-sheets.js",
    "x:sync": "node --dns-result-order=ipv4first scripts/sync-posted-status.js",
    "x:reset-stale": "node scripts/reset-stale-posts.js",
    "x:post": "node --dns-result-order=ipv4first scripts/post-to-x.js",
    "check:links": "node scripts/check-amazon-links.js",
    "check:prices": "node scripts/price-monitor.js",
    "repost:popular": "node scripts/popular-repost.js",
    "report:weekly": "node scripts/weekly-report.js",
    "seo:links": "node scripts/internal-links.js",
    "seo:links:apply": "node scripts/internal-links.js --apply",
    "x:orchestrate:weekly": "node --dns-result-order=ipv4first scripts/orchestrate.js --pipeline weekly",
    "x:orchestrate:daily": "node --dns-result-order=ipv4first scripts/orchestrate.js --pipeline daily",
    "x:orchestrate:weekly:dry": "node --dns-result-order=ipv4first scripts/orchestrate.js --pipeline weekly --dry-run",
    "x:orchestrate:daily:dry": "node --dns-result-order=ipv4first scripts/orchestrate.js --pipeline daily --dry-run",
    "x:research:youtube": "node --dns-result-order=ipv4first scripts/youtube-researcher.js",
    "x:research:youtube:dry": "node --dns-result-order=ipv4first scripts/youtube-researcher.js --dry-run",
    "x:research:google": "node --dns-result-order=ipv4first scripts/research-sources/google-trends.js",
    "x:research:google:dry": "node --dns-result-order=ipv4first scripts/research-sources/google-trends.js --dry-run",
    "x:research:rakuten": "node --dns-result-order=ipv4first scripts/research-sources/rakuten-ranking.js",
    "x:research:rakuten:dry": "node --dns-result-order=ipv4first scripts/research-sources/rakuten-ranking.js --dry-run",
    "x:research:amazon": "node --dns-result-order=ipv4first scripts/research-sources/amazon-reviews.js",
    "x:research:amazon:dry": "node --dns-result-order=ipv4first scripts/research-sources/amazon-reviews.js --dry-run",
    "x:kill": "node scripts/supervisor-agent.js --kill",
    "x:resume": "node scripts/supervisor-agent.js --resume",
    "article:weekly": "node --dns-result-order=ipv4first scripts/article-orchestrate.js --pipeline weekly",
    "article:daily": "node --dns-result-order=ipv4first scripts/article-orchestrate.js --pipeline daily",
    "article:weekly:dry": "node --dns-result-order=ipv4first scripts/article-orchestrate.js --pipeline weekly --dry-run",
    "article:daily:dry": "node --dns-result-order=ipv4first scripts/article-orchestrate.js --pipeline daily --dry-run",
    "article:kill": "node -e \"const fs=require('fs');const d=JSON.parse(fs.readFileSync('data/kill-switch.json'));d.articleEnabled=true;fs.writeFileSync('data/kill-switch.json',JSON.stringify(d,null,2))\"",
    "article:resume": "node -e \"const fs=require('fs');const d=JSON.parse(fs.readFileSync('data/kill-switch.json'));d.articleEnabled=false;fs.writeFileSync('data/kill-switch.json',JSON.stringify(d,null,2))\"",
    "db:migrate": "node --dns-result-order=ipv4first scripts/migrate-to-supabase.js",
    "db:migrate:dry": "node --dns-result-order=ipv4first scripts/migrate-to-supabase.js --dry-run",
    "db:sync": "node --dns-result-order=ipv4first scripts/sync-to-supabase.js",
    "db:sync:dry": "node --dns-result-order=ipv4first scripts/sync-to-supabase.js --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@supabase/supabase-js": "^2.103.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "puppeteer": "^24.40.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "twitter-api-v2": "^1.29.0",
    "uuid": "^13.0.0",
    "youtube-transcript": "^1.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module"
}
