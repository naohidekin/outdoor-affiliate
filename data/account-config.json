  "axes": [
    { "id": "camp",      "name": "キャンプ・ギア", "ratio": 0.40, "tone": "断言型" },
    { "id": "ai",        "name": "AI・Claude Code", "ratio": 0.25, "tone": "砕けた開発日記調" },
    { "id": "parenting", "name": "子育て×アウトドア", "ratio": 0.20, "tone": "ほっこり〜自虐" },
    { "id": "doctor",    "name": "医師×健康",       "ratio": 0.15, "tone": "控えめ匂わせ" }
