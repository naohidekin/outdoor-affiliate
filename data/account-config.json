    "political": ["自民党", "立憲", "共産党", "公明党", "維新"]
  },

  "linkRules": {
    "noUrlInBody": true,
    "urlInReply": true,
    "ctaText": "詳細はリプ欄へ。"
  },

  "bookmarkStrategy": {
    "hooks": ["【保存版】", "【ブクマ推奨】", "【まとめ】"],
    "formats": ["豆知識", "比較", "チェックリスト", "tips", "○○の見分け方"],
    "note": "毎回ではなく情報密度が高い投稿に使う"
