{
  "schemaVersion": 1,
  "maxActiveExperiments": 3,
  "maxNewPerRun": 1,
  "budget": {
    "targetCreditsPerOperationRun": 50,
    "maxWeeklyOperationCredits": 200,
    "maxMetricsAgeHours": 72,
    "paidUsd": "unknown unless an external invoice is recorded"
  },
  "models": {
    "gpt-6-astra": {
      "role": "selection, evidence approval, causal evaluation, and publication decisions",
      "maxInputTokens": null,
      "maxOutputTokens": null
