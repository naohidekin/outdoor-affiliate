    "gpt-5.6-terra": { "role": "bounded research and code" },
    "gpt-5.6-luna": { "role": "deterministic extraction support only" },
    "none": { "role": "metrics collection and preflight" }
  },
  "measurement": {
    "country": "jpn",
    "device": "separate cohorts; never aggregate a cohort after approval",
    "gscDateBasis": "America/Los_Angeles",
    "operationTimezone": "Asia/Tokyo",
    "checkpointsDays": [7, 14, 28, 42]
  },
  "publicationManifestAuthoritativeSource": "scripts/seo/publish.mjs validateManifest"
}
