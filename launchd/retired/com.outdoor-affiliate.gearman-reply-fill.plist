<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.outdoor-affiliate.gearman-reply-fill</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/USERNAME/dev/outdoor-affiliate/scripts/x/reply-fill.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/USERNAME/dev/outdoor-affiliate</string>
  <!-- 10分ごと。対象が無い時は Notion を1回問い合わせて即終了(LLM不使用=$0)。
       間隔を短くしてもコストは増えない -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>StandardOutPath</key>
  <string>/Users/USERNAME/dev/outdoor-affiliate/logs/gearman-reply-fill.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/dev/outdoor-affiliate/logs/gearman-reply-fill-error.log</string>
</dict>
</plist>
