<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.outdoor-affiliate.link-check</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/USERNAME/dev/outdoor-affiliate/scripts/notify-on-error.sh</string>
		<string>リンク切れチェック</string>
		<string>/opt/homebrew/bin/node</string>
		<string>--dns-result-order=ipv4first</string>
		<string>/Users/USERNAME/dev/outdoor-affiliate/scripts/check-amazon-links.js</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<!-- 毎週日曜 6:30（価格監視の後） -->
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/USERNAME/dev/outdoor-affiliate</string>
	<key>StandardOutPath</key>
	<string>/Users/USERNAME/dev/outdoor-affiliate/logs/launchd-link-check.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/USERNAME/dev/outdoor-affiliate/logs/launchd-link-check-error.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
</dict>
</plist>
