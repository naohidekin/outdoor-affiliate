<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.outdoor-affiliate.link-fix</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>/Users/USERNAME/dev/outdoor-affiliate/scripts/link-fix.mjs</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/USERNAME/dev/outdoor-affiliate</string>
	<key>StandardOutPath</key>
	<string>/Users/USERNAME/dev/outdoor-affiliate/logs/launchd-link-fix.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/USERNAME/dev/outdoor-affiliate/logs/launchd-link-fix-error.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
</dict>
</plist>
